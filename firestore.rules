rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Core Helper Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email_verified' in request.auth.token &&
         request.auth.token.email_verified == true &&
         'email' in request.auth.token &&
         request.auth.token.email == 'mildous15@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Entity Validation Helpers ---
    function isValidStoreConfig(data) {
      return data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 100 &&
             data.businessNameAr is string && data.businessNameAr.size() >= 1 && data.businessNameAr.size() <= 100 &&
             data.address is string && data.address.size() >= 1 && data.address.size() <= 250 &&
             data.latitude is number && data.latitude >= -90 && data.latitude <= 90 &&
             data.longitude is number && data.longitude >= -180 && data.longitude <= 180 &&
             data.mapsUrl is string && data.mapsUrl.size() >= 1 && data.mapsUrl.size() <= 500 &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 40)) &&
             (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 40)) &&
             (!('facebookUrl' in data) || (data.facebookUrl is string && data.facebookUrl.size() <= 500)) &&
             (!('instagramUrl' in data) || (data.instagramUrl is string && data.instagramUrl.size() <= 500)) &&
             (!('bannerTitleAr' in data) || (data.bannerTitleAr is string && data.bannerTitleAr.size() <= 160)) &&
             (!('bannerTitleFr' in data) || (data.bannerTitleFr is string && data.bannerTitleFr.size() <= 160)) &&
             (!('bannerSubtitleAr' in data) || (data.bannerSubtitleAr is string && data.bannerSubtitleAr.size() <= 300)) &&
             (!('bannerSubtitleFr' in data) || (data.bannerSubtitleFr is string && data.bannerSubtitleFr.size() <= 300)) &&
             data.bannerActive is bool &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCategory(data) {
      return data.nameAr is string && data.nameAr.size() >= 1 && data.nameAr.size() <= 80 &&
             data.nameFr is string && data.nameFr.size() >= 1 && data.nameFr.size() <= 80 &&
             data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 60 &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
             data.active is bool &&
             data.iconKey is string && data.iconKey.size() >= 1 && data.iconKey.size() <= 40 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidProduct(data) {
      return data.nameAr is string && data.nameAr.size() >= 1 && data.nameAr.size() <= 120 &&
             data.nameFr is string && data.nameFr.size() >= 1 && data.nameFr.size() <= 120 &&
             (!('descriptionAr' in data) || (data.descriptionAr is string && data.descriptionAr.size() <= 1500)) &&
             (!('descriptionFr' in data) || (data.descriptionFr is string && data.descriptionFr.size() <= 1500)) &&
             data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 128 &&
             data.priceDzd is number && data.priceDzd > 0 && data.priceDzd <= 10000000 &&
             (!('discountPriceDzd' in data) || (data.discountPriceDzd is number && data.discountPriceDzd >= 0 && data.discountPriceDzd < data.priceDzd)) &&
             data.sizes is list && data.sizes.size() <= 20 && (data.sizes.size() == 0 || data.sizes[0] is string) &&
             data.colors is list && data.colors.size() <= 20 && (data.colors.size() == 0 || data.colors[0] is string) &&
             data.stockQuantity is int && data.stockQuantity >= 0 && data.stockQuantity <= 100000 &&
             data.inStock is bool &&
             data.featured is bool &&
             data.newArrival is bool &&
             data.specialOffer is bool &&
             data.active is bool &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 350000)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 40)) &&
             (!('defaultAddress' in data) || (data.defaultAddress is string && data.defaultAddress.size() <= 300)) &&
             data.preferredLang in ['ar', 'fr'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCartItem(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128 &&
             data.productNameAr is string && data.productNameAr.size() >= 1 && data.productNameAr.size() <= 120 &&
             data.productNameFr is string && data.productNameFr.size() >= 1 && data.productNameFr.size() <= 120 &&
             (!('productImageUrl' in data) || (data.productImageUrl is string && data.productImageUrl.size() <= 350000)) &&
             data.unitPriceDzd is number && data.unitPriceDzd >= 0 && data.unitPriceDzd <= 10000000 &&
             data.selectedSize is string && data.selectedSize.size() <= 40 &&
             data.selectedColor is string && data.selectedColor.size() <= 40 &&
             data.quantity is int && data.quantity >= 1 && data.quantity <= 99 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidOrder(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
             data.phoneNumber is string && data.phoneNumber.size() >= 6 && data.phoneNumber.size() <= 40 &&
             data.deliveryAddress is string && data.deliveryAddress.size() >= 4 && data.deliveryAddress.size() <= 300 &&
             data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && data.items[0] is map &&
             data.subtotalDzd is number && data.subtotalDzd >= 0 && data.subtotalDzd <= 100000000 &&
             data.totalDzd is number && data.totalDzd >= 0 && data.totalDzd <= 100000000 &&
             data.status in ['pending', 'confirmed', 'shipped', 'delivered', 'cancelled'] &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidReservation(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
             data.phoneNumber is string && data.phoneNumber.size() >= 6 && data.phoneNumber.size() <= 40 &&
             data.preferredDate is string && data.preferredDate.size() >= 4 && data.preferredDate.size() <= 40 &&
             data.preferredTime is string && data.preferredTime.size() >= 2 && data.preferredTime.size() <= 40 &&
             data.visitorCount is int && data.visitorCount >= 1 && data.visitorCount <= 20 &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             data.channel in ['whatsapp', 'in_app'] &&
             data.status in ['pending', 'confirmed', 'completed', 'cancelled'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAdminRole(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             isValidTimestamp(data.createdAt);
    }

    // --- Collection Rules ---

    // 1. Store Config (publicly readable single doc 'main' by signed-in users, writable by admins only)
    match /store_config/{configId} {
      allow get: if isSignedIn() && configId == 'main';
      allow list: if false;
      allow create: if isAdmin() &&
                       configId == 'main' &&
                       incoming().keys().hasAll(['businessName', 'businessNameAr', 'address', 'latitude', 'longitude', 'mapsUrl', 'bannerActive', 'updatedAt']) &&
                       incoming().keys().hasOnly(['businessName', 'businessNameAr', 'address', 'latitude', 'longitude', 'mapsUrl', 'phoneNumber', 'whatsappNumber', 'facebookUrl', 'instagramUrl', 'bannerTitleAr', 'bannerTitleFr', 'bannerSubtitleAr', 'bannerSubtitleFr', 'bannerActive', 'updatedAt']) &&
                       isValidStoreConfig(incoming());
      allow update: if isAdmin() &&
                       configId == 'main' &&
                       isValidStoreConfig(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['businessName', 'businessNameAr', 'address', 'latitude', 'longitude', 'mapsUrl', 'phoneNumber', 'whatsappNumber', 'facebookUrl', 'instagramUrl', 'bannerTitleAr', 'bannerTitleFr', 'bannerSubtitleAr', 'bannerSubtitleFr', 'bannerActive', 'updatedAt']);
      allow delete: if false;
    }

    // 2. Categories
    match /categories/{categoryId} {
      allow get: if isSignedIn() && isValidId(categoryId) && (existing().active == true || isAdmin());
      allow list: if isSignedIn() && (existing().active == true || isAdmin());
      allow create: if isAdmin() &&
                       isValidId(categoryId) &&
                       incoming().keys().hasAll(['nameAr', 'nameFr', 'slug', 'sortOrder', 'active', 'iconKey', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['nameAr', 'nameFr', 'slug', 'sortOrder', 'active', 'iconKey', 'createdAt', 'updatedAt']) &&
                       isValidCategory(incoming());
      allow update: if isAdmin() &&
                       isValidId(categoryId) &&
                       isValidCategory(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['nameAr', 'nameFr', 'slug', 'sortOrder', 'active', 'iconKey', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    // 3. Products
    match /products/{productId} {
      allow get: if isSignedIn() && isValidId(productId) && (existing().active == true || isAdmin());
      allow list: if isSignedIn() && (existing().active == true || isAdmin());
      allow create: if isAdmin() &&
                       isValidId(productId) &&
                       incoming().keys().hasAll(['nameAr', 'nameFr', 'categoryId', 'priceDzd', 'sizes', 'colors', 'stockQuantity', 'inStock', 'featured', 'newArrival', 'specialOffer', 'active', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['nameAr', 'nameFr', 'descriptionAr', 'descriptionFr', 'categoryId', 'priceDzd', 'discountPriceDzd', 'sizes', 'colors', 'stockQuantity', 'inStock', 'featured', 'newArrival', 'specialOffer', 'active', 'imageUrl', 'createdAt', 'updatedAt']) &&
                       isValidProduct(incoming());
      allow update: if isAdmin() &&
                       isValidId(productId) &&
                       isValidProduct(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['nameAr', 'nameFr', 'descriptionAr', 'descriptionFr', 'categoryId', 'priceDzd', 'discountPriceDzd', 'sizes', 'colors', 'stockQuantity', 'inStock', 'featured', 'newArrival', 'specialOffer', 'active', 'imageUrl', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(productId);
    }

    // 4. Users & Cart Subcollection (strictly PII-isolated)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'preferredLang', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'phoneNumber', 'defaultAddress', 'preferredLang', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'phoneNumber', 'defaultAddress', 'preferredLang', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /cart/{cartItemId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() &&
                         isValidId(cartItemId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'productId', 'productNameAr', 'productNameFr', 'unitPriceDzd', 'selectedSize', 'selectedColor', 'quantity', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'productId', 'productNameAr', 'productNameFr', 'productImageUrl', 'unitPriceDzd', 'selectedSize', 'selectedColor', 'quantity', 'createdAt', 'updatedAt']) &&
                         isValidCartItem(incoming());
        allow update: if isSignedIn() &&
                         isValidId(cartItemId) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidCartItem(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'selectedSize', 'selectedColor', 'unitPriceDzd', 'updatedAt']);
        allow delete: if isSignedIn() && isValidId(cartItemId) && request.auth.uid == userId;
      }
    }

    // 5. Orders (owner-isolated + admin management)
    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(orderId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'pending' &&
                       incoming().keys().hasAll(['userId', 'customerName', 'phoneNumber', 'deliveryAddress', 'items', 'subtotalDzd', 'totalDzd', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'customerName', 'phoneNumber', 'deliveryAddress', 'items', 'subtotalDzd', 'totalDzd', 'status', 'notes', 'createdAt', 'updatedAt']) &&
                       isValidOrder(incoming());
      allow update: if isSignedIn() &&
                       isValidId(orderId) &&
                       isValidOrder(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() || (
                           existing().userId == request.auth.uid &&
                           existing().status == 'pending' &&
                           incoming().status == 'cancelled' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
                         )
                       );
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // 6. Boutique Reservations (owner-isolated + admin management)
    match /reservations/{reservationId} {
      allow get: if isSignedIn() && isValidId(reservationId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(reservationId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'pending' &&
                       incoming().keys().hasAll(['userId', 'customerName', 'phoneNumber', 'preferredDate', 'preferredTime', 'visitorCount', 'channel', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'customerName', 'phoneNumber', 'preferredDate', 'preferredTime', 'visitorCount', 'notes', 'channel', 'status', 'createdAt', 'updatedAt']) &&
                       isValidReservation(incoming());
      allow update: if isSignedIn() &&
                       isValidId(reservationId) &&
                       isValidReservation(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() || (
                           existing().userId == request.auth.uid &&
                           existing().status == 'pending' &&
                           incoming().status == 'cancelled' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
                         )
                       );
      allow delete: if isAdmin() && isValidId(reservationId);
    }

    // 7. Admins
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() &&
                       isValidId(adminId) &&
                       incoming().uid == adminId &&
                       incoming().keys().hasAll(['uid', 'createdAt']) &&
                       incoming().keys().hasOnly(['uid', 'email', 'createdAt']) &&
                       isValidAdminRole(incoming());
      allow update: if false;
      allow delete: if isAdmin() && isValidId(adminId);
    }
  }
}
